MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
ADMIN_EMAIL=admin@yourebooksite.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback
BACKEND_URL=https://your-backend.onrender.com
RENDER_EXTERNAL_URL=https://your-backend.onrender.com
AUTH_COOKIE_NAME=ebook_auth_token
OPENAI_API_KEY=sk-...
# Optional: point to another hosted provider only if it supports the OpenAI
# Responses API and embeddings for the models below.
OPENAI_BASE_URL=
OPENAI_MODERATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
# Local development can use Ollama on your own machine.
# Hosted production must use either a cloud AI key or a remote Ollama server,
# not http://127.0.0.1 from inside Render.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_DIMENSIONS=
OLLAMA_AUTH_TOKEN=
OLLAMA_TIMEOUT_MS=90000
AI_PDF_PARSE_MAX_BYTES=20971520
